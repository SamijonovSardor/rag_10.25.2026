# OpenRouter kalitingizni .env fayliga yozing. Haqiqiy kalitni bu namunaga qo'ymang.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-6-luna
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# 0 = modelning standart vektor o'lchami. O'zgarsa indeksni qayta yarating.
OPENROUTER_EMBEDDING_DIMENSIONS=0
OPENROUTER_EMBEDDING_BATCH_SIZE=32
OPENROUTER_TIMEOUT_SECONDS=120
